# Frontend Public Domain (e.g. https://your-billflow.vercel.app or http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API Service URL used by Next.js Rewrites to proxy /api/* requests
# In production on Vercel: set to your Render backend service URL (e.g. https://billflow-backend.onrender.com)
BACKEND_API_URL=http://localhost:5000

# Public Razorpay Key for client checkout modal
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
