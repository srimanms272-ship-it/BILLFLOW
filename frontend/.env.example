# Frontend Public Domain (e.g. https://your-billflow.vercel.app or http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API Service URL used by Next.js Rewrites to proxy /api/* requests
# In production on Vercel:
BACKEND_API_URL=https://billflow-backend-ntt5.onrender.com

# Public Razorpay Key for client checkout modal
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
