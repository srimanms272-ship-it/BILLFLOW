# Environment Mode
NODE_ENV=production
PORT=5000

# MongoDB Atlas Connection URI
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/billing_system?retryWrites=true&w=majority

# Better Auth Configuration
# Secret string used to sign session cookies and tokens (min 32 characters)
BETTER_AUTH_SECRET=your_32_character_random_secret_string

# Canonical Backend URL (e.g. https://billflow-backend.onrender.com or http://localhost:5000)
BETTER_AUTH_URL=http://localhost:5000

# Canonical Frontend Public URL (e.g. https://your-billflow.vercel.app or http://localhost:3000)
# Used for email action links (invoice payment links, password resets, verification)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay API Credentials
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# SMTP Email Configuration (Gmail, Resend SMTP, SendGrid, etc.)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=BillFlow <noreply@yourdomain.com>

# App Branding
APP_NAME=BillFlow
APP_URL=http://localhost:3000

# Optional Features
REQUIRE_EMAIL_VERIFICATION=false
